<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="100%" height="100%">
  <defs>
    <radialGradient id="bgGlow_kelapa.jpg" cx="50%" cy="50%" r="65%">
      <stop offset="0%" stop-color="#4FA399" stop-opacity="0.30"/>
      <stop offset="100%" stop-color="#1C2C2A" stop-opacity="1"/>
    </radialGradient>
    <filter id="shadow_kelapa.jpg" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="6" stdDeviation="10" flood-color="#000" flood-opacity="0.4"/>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="600" height="400" fill="url(#bgGlow_kelapa.jpg)"/>

  <!-- Warm ambient circles -->
  <circle cx="100" cy="80" r="140" fill="#4FA399" opacity="0.08"/>
  <circle cx="520" cy="320" r="160" fill="#4FA399" opacity="0.08"/>

  <!-- Elegant Platter Plate -->
  <ellipse cx="300" cy="205" rx="190" ry="105" fill="#241711" stroke="#4FA399" stroke-width="2" opacity="0.9" filter="url(#shadow_kelapa.jpg)"/>
  <ellipse cx="300" cy="205" rx="170" ry="90" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" stroke-dasharray="6 4"/>

  <!-- Dish Title Badge -->
  <rect x="180" y="180" width="240" height="50" rx="6" fill="#1A100B" stroke="#4FA399" stroke-width="1.5" filter="url(#shadow_kelapa.jpg)"/>
  <text x="300" y="212" font-family="'Playfair Display', Georgia, serif" font-size="18" font-weight="700" fill="#FAF8F5" text-anchor="middle" letter-spacing="2">
    KELAPA
  </text>

  <!-- Bottom Details -->
  <rect x="0" y="325" width="600" height="75" fill="rgba(20, 12, 8, 0.85)"/>
  <text x="40" y="356" font-family="'Playfair Display', Georgia, serif" font-size="22" font-weight="bold" fill="#FAF8F5" letter-spacing="0.5">
    Jus Kelapa Muda
  </text>
  <text x="40" y="380" font-family="'DM Sans', sans-serif" font-size="14" fill="#4FA399">
    Fresh Coconut Juice • Warung Satay Royale
  </text>
</svg>